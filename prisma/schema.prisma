// Surwahi backend schema (Prisma 7).
// Only tables owned by the admin backend live here. The legacy hand-made tables
// (newsletter_subscriptions, contact_submissions, and the empty rooms/blog_posts/activities
// stubs) are NOT modelled and are never touched by migrations.
// SQL migrations: db/migrations/*.sql, applied by scripts/db-migrate.mjs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

// ─── Admin users & auth ───────────────────────────────────────────────

enum AdminRole {
  OWNER   // everything, incl. users
  MANAGER // bookings, calendar, rates
  EDITOR  // photos, content
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String
  role         AdminRole
  passwordHash String         @map("password_hash")
  isActive     Boolean        @default(true) @map("is_active")
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  sessions     AdminSession[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("admin_sessions")
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?    @map("entity_id")
  data      Json?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([entity, entityId])
  @@map("audit_log")
}

// ─── Rooms, rates, photos ─────────────────────────────────────────────

enum AccommodationCategory {
  SUITE
  DORMITORY
  CAMPING
}

enum PricingModel {
  PER_UNIT   // price covers includedAdults; extra adults charged
  PER_PERSON // price per guest per night
}

model Accommodation {
  id               String                @id @default(uuid()) @db.Uuid
  slug             String                @unique
  name             String
  category         AccommodationCategory
  shortDescription String                @map("short_description")
  longDescription  String                @map("long_description")
  bedConfiguration String                @map("bed_configuration")
  size             String?
  view             String?
  location         String?
  maxOccupancy     Int                   @map("max_occupancy")
  pricingModel     PricingModel          @map("pricing_model")
  /// Pre-GST rupees per night
  basePrice        Int                   @map("base_price")
  extraAdultPrice  Int?                  @map("extra_adult_price")
  includedAdults   Int?                  @map("included_adults")
  /// Null = children's rate confirmed manually
  childPrice       Int?                  @map("child_price")
  gstPercent       Decimal               @default(18) @map("gst_percent") @db.Decimal(5, 2)
  mealPlan         String                @map("meal_plan")
  amenities        String[]
  ecoFeatures      String[]              @map("eco_features")
  accessibility    String[]
  included         String[]
  policies         Json                  @default("{}")
  keywords         String[]
  isActive         Boolean               @default(true) @map("is_active")
  sortOrder        Int                   @default(0) @map("sort_order")
  /// Secret used in this room's public iCal export URL
  icalExportToken  String                @unique @default(uuid()) @map("ical_export_token")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  images       AccommodationImage[]
  rateRules    RateRule[]
  reservations Reservation[]
  blocks       CalendarBlock[]
  icalFeeds    IcalFeed[]

  @@map("accommodations")
}

model MediaAsset {
  id              String               @id @default(uuid()) @db.Uuid
  url             String
  /// ImageKit fileId when uploaded through the admin; null for legacy URLs
  providerFileId  String?              @map("provider_file_id")
  filePath        String?              @map("file_path")
  width           Int?
  height          Int?
  alt             String
  caption         String?
  tags            String[]
  /// Shown on /gallery when set
  galleryCategory String?              @map("gallery_category")
  gallerySort     Int                  @default(0) @map("gallery_sort")
  uploadedById    String?              @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  accommodations  AccommodationImage[]

  @@index([galleryCategory])
  @@map("media_assets")
}

model AccommodationImage {
  accommodationId String        @map("accommodation_id") @db.Uuid
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  mediaId         String        @map("media_id") @db.Uuid
  media           MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0) @map("sort_order")
  caption         String?

  @@id([accommodationId, mediaId])
  @@map("accommodation_images")
}

/// Seasonal / date-range price override. Highest priority wins on overlap.
model RateRule {
  id              String        @id @default(uuid()) @db.Uuid
  accommodationId String        @map("accommodation_id") @db.Uuid
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime      @map("start_date") @db.Date
  /// Inclusive last night the rule applies to
  endDate         DateTime      @map("end_date") @db.Date
  basePrice       Int           @map("base_price")
  extraAdultPrice Int?          @map("extra_adult_price")
  minNights       Int?          @map("min_nights")
  priority        Int           @default(0)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([accommodationId, startDate, endDate])
  @@map("rate_rules")
}

// ─── Bookings & calendar ──────────────────────────────────────────────

enum ReservationStatus {
  REQUESTED        // guest asked; not holding dates yet
  AWAITING_PAYMENT // confirmed by staff, payment link sent; holds dates
  CONFIRMED        // paid / guaranteed; holds dates
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ReservationSource {
  WEBSITE
  PHONE
  WHATSAPP
  WALK_IN
  AIRBNB
  BOOKING_COM
  OTHER
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique
  accommodationId String            @map("accommodation_id") @db.Uuid
  accommodation   Accommodation     @relation(fields: [accommodationId], references: [id])
  checkIn         DateTime          @map("check_in") @db.Date
  checkOut        DateTime          @map("check_out") @db.Date
  adults          Int
  children        Int               @default(0)
  /// Dormitory: book every bed (private group)
  exclusive       Boolean           @default(false)
  guestName       String            @map("guest_name")
  guestEmail      String            @map("guest_email")
  guestPhone      String            @map("guest_phone")
  specialRequests String?           @map("special_requests")
  status          ReservationStatus @default(REQUESTED)
  source          ReservationSource @default(WEBSITE)
  subtotal        Int
  gst             Int
  total           Int
  priceBreakdown  Json              @map("price_breakdown")
  paymentLinkUrl  String?           @map("payment_link_url")
  paymentLinkId   String?           @map("payment_link_id")
  amountPaid      Int               @default(0) @map("amount_paid")
  paidAt          DateTime?         @map("paid_at") @db.Timestamptz
  internalNotes   String?           @map("internal_notes")
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@index([accommodationId, checkIn, checkOut])
  @@index([status])
  @@map("reservations")
}

enum BlockSource {
  MANUAL
  ICAL
}

/// Dates a room is unavailable outside a reservation (maintenance, owner use, OTA bookings).
model CalendarBlock {
  id              String        @id @default(uuid()) @db.Uuid
  accommodationId String        @map("accommodation_id") @db.Uuid
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  startDate       DateTime      @map("start_date") @db.Date
  /// Exclusive (checkout-style) end date
  endDate         DateTime      @map("end_date") @db.Date
  reason          String?
  source          BlockSource   @default(MANUAL)
  icalFeedId      String?       @map("ical_feed_id") @db.Uuid
  icalFeed        IcalFeed?     @relation(fields: [icalFeedId], references: [id], onDelete: Cascade)
  externalUid     String?       @map("external_uid")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([icalFeedId, externalUid])
  @@index([accommodationId, startDate, endDate])
  @@map("calendar_blocks")
}

/// An OTA calendar (Airbnb, Booking.com) imported into our availability.
model IcalFeed {
  id              String          @id @default(uuid()) @db.Uuid
  accommodationId String          @map("accommodation_id") @db.Uuid
  accommodation   Accommodation   @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  url             String
  isActive        Boolean         @default(true) @map("is_active")
  lastSyncedAt    DateTime?       @map("last_synced_at") @db.Timestamptz
  lastStatus      String?         @map("last_status")
  lastError       String?         @map("last_error")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  blocks          CalendarBlock[]

  @@map("ical_feeds")
}
